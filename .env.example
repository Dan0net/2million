# ─────────────────────────────────────────────────────────────
# Rent-a-Pixel environment variables
# Set these in the Netlify UI: Site configuration → Environment variables.
# ─────────────────────────────────────────────────────────────

# TEST MODE (default: on).
# When "true" (or unset), anyone can claim pixels for FREE — Stripe is skipped
# entirely, so the site works with no payment setup at all.
# Set to "false" to require real Stripe payments.
TEST_MODE="true"

# ── Only needed when TEST_MODE="false" ──────────────────────────

# Stripe secret key (test key looks like sk_test_...; live like sk_live_...)
STRIPE_SECRET_KEY=""

# Signing secret of the webhook endpoint you register in the Stripe dashboard
# (Developers → Webhooks). Looks like whsec_...
STRIPE_WEBHOOK_SECRET=""

# ID of a $1.00 / month RECURRING Price you create in the Stripe dashboard.
# Used for the "rent" option. Looks like price_...
# (The $1000 lifetime purchase is created inline and needs no Price ID.)
STRIPE_RENT_PRICE_ID=""
